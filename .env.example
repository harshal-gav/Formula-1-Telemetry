# ==============================================================================
# FORMULA 1 PRO ANALYTICS — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local and configure your credentials.
# NEVER commit .env.local to version control.

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE CREDENTIALS (Firebase Console -> Project Settings)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN SDK (Used ONLY in /api/dodo/webhook)
# (Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# For FIREBASE_ADMIN_PRIVATE_KEY, include full RSA key with literal \n: "-----BEGIN PRIVATE KEY-----\nMIIEv...-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. DODO PAYMENTS CONFIGURATION (Dodo Payments Dashboard)
# ------------------------------------------------------------------------------
# Environment mode: "test" or "live"
NEXT_PUBLIC_DODO_ENV=test

# Dodo Business ID (Used for Customer Portal redirect)
NEXT_PUBLIC_DODO_BUSINESS_ID=bus_xxxxxxxxxx

# Dodo Monthly Pro Product ID
DODO_PRODUCT_ID=pdt_xxxxxxxxxx
NEXT_PUBLIC_DODO_PRODUCT_ID=pdt_xxxxxxxxxx

# Server API Key (For Dodo API requests if verifying status server-side)
DODO_PAYMENTS_API_KEY=dodo_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook Signing Secret (starts with whsec_..., generated in Dodo Webhook settings)
DODO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

